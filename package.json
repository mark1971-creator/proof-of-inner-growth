{
  "name": "proof-of-inner-growth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contract/inner-growth.compact contract/managed/inner-growth",
    "compile:fast": "compact compile --skip-zk contract/inner-growth.compact contract/managed/inner-growth",
    "typecheck": "tsc --noEmit -p .",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run --exclude 'src/**/*.sim.test.ts'",
    "test:sim": "vitest run --passWithNoTests .sim.test.ts",
    "test:local": "MIDNIGHT_NETWORK=local npm test --",
    "test:preview": "MIDNIGHT_NETWORK=preview npm test --",
    "test:preprod": "MIDNIGHT_NETWORK=preprod npm test --",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "proof:up": "docker compose up -d --wait proof-server",
    "proof:down": "docker compose stop proof-server",
    "wait:dust": "vite-node scripts/wait-for-dust.ts",
    "deploy": "vite-node scripts/deploy.ts",
    "deploy:preview": "MIDNIGHT_NETWORK=preview npm run deploy --",
    "deploy:preprod": "MIDNIGHT_NETWORK=preprod npm run deploy --",
    "validate": "npm run compile && npm run env:up && npm run wait:dust && npm run test:local; s=$?; npm run env:down; exit $s"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "5.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.1",
    "@midnight-ntwrk/midnight-js-types": "5.0.1",
    "@midnight-ntwrk/midnight-js-utils": "5.0.1",
    "@midnight-ntwrk/testkit-js": "5.0.1",
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.7.0",
    "vite": "6.4.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4",
    "bn.js": "5.2.5"
  },
  "description": "Proof of Inner Growth: prove a course practice goal for inner development with a zero-knowledge proof on Midnight, without revealing the diary.",
  "license": "Apache-2.0",
  "overrides": {
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2",
    "@midnightntwrk/zkir-v3": "3.2.1",
    "vite-plugin-top-level-await": {
      "@swc/core": "1.15.47",
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "@swc/core": false,
    "classic-level": false,
    "cpu-features": false,
    "dtrace-provider": false,
    "msgpackr-extract": false,
    "protobufjs": false,
    "ssh2": false
  }
}
